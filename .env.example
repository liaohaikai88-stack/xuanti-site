# 复制为 .env 后使用。不要把填了真实密码的 .env 提交到仓库。
# 仓库是公开的，示例值只能用于本机开发。

# 站点实际访问地址。本地开发保持 localhost；域名备案并解析后改成 https://你的域名
APP_URL=http://localhost:3000

# 主域名。sitemap、robots 和页面上的规范地址默认用 https://这个域名。
# 本地 APP_URL 仍是 localhost，不会把登录跳转指到线上。换域名时只改这里。
SITE_DOMAIN=jintianpaisha.cn

# SQLite 文件。服务器上建议 /var/lib/xuanti/app.db
DATABASE_PATH=./data/app.db

# 会话令牌的胡椒。生产环境必须换成足够长的随机字符串，否则进程会拒绝启动。
# 生成示例：openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string

# 首次启动时，如果这个邮箱还不存在，会创建管理员。已存在则不会改密码。
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-only-change-me

# 未登录访客每天能看的选题条数，限制在 3 到 5，默认 4。
FREE_PREVIEW_COUNT=4

# 收费开关。没有营业执照之前保持 false。
# false：不展示价格、订单和会员升级；任意登录用户可看全部内容。
# true：免费用户只看预览，年度会员看全部；用户可提交订单，由管理员人工开通。
MEMBERSHIP_BILLING_ENABLED=false
ANNUAL_PRICE_YUAN=199
PAYMENT_PROVIDER=manual

# OpenAI 兼容的文案接口。LLM_API_KEY 留空时，文案工具使用本地提纲，站点仍可正常使用。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 手机号验证码登录尚未接入。留空即可。
SMS_PROVIDER=none
# SMS_ACCESS_KEY=
# SMS_ACCESS_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
